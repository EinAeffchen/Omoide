# =============================================================================
# Docker Compose variables — used by docker-compose.yml directly
# =============================================================================

# Host port to expose the app on
PORT=8123

# Host path to your media folder (images, videos, etc.)
HOST_MEDIA_DIR=<folder containing images>

# Host path for persistent data (database, thumbnails, etc.)
HOST_DATA_DIR=<ssd volume to save database, thumbnails etc. into>

# Path to the app-level env file passed into the container
ENV_FILE=omoide.env


# =============================================================================
# App variables — go in the file referenced by ENV_FILE (default: omoide.env)
# These are passed into the container and override config.yaml settings.
# =============================================================================

# --- General -----------------------------------------------------------------

# Server domain shown in API responses
# OMOIDE_GENERAL__DOMAIN=http://localhost:8123

# Hide all write operations (no uploads, edits, or deletes)
# OMOIDE_GENERAL__PRESENTATION_MODE=false

# Enable face recognition and people tracking features
# OMOIDE_GENERAL__ENABLE_PEOPLE=true

# Show original GIFs in grid views instead of thumbnails
# OMOIDE_GENERAL__MEME_MODE=false

# --- AI / Search -------------------------------------------------------------

# CLIP model used for image and text embeddings
# Options: xlm-roberta-base-ViT-B-32, xlm-roberta-large-ViT-H-14, ViT-B-32, ViT-L-14, convnext_base_w
# OMOIDE_AI__CLIP_MODEL=xlm-roberta-base-ViT-B-32

# Minimum cosine similarity for search results (0.0–1.0, higher = stricter)
# OMOIDE_AI__MIN_SEARCH_DIST=0.80

# --- Scanning ----------------------------------------------------------------

# Automatically scan the media folder for new files on a schedule
# OMOIDE_SCAN__AUTO_SCAN=false

# Minutes between automatic scans (only used when AUTO_SCAN=true)
# OMOIDE_SCAN__SCAN_INTERVAL_MINUTES=15

# Auto-rotate images based on EXIF orientation metadata
# OMOIDE_SCAN__AUTO_ROTATE=true

# --- Tagging -----------------------------------------------------------------

# Automatically tag new media using AI classification
# OMOIDE_TAGGING__AUTO_TAGGING=true

# Include the built-in default tag vocabulary
# OMOIDE_TAGGING__USE_DEFAULT_TAGS=true

# Additional tags to apply during auto-tagging (comma-separated)
# OMOIDE_TAGGING__CUSTOM_TAGS=

# --- Face Recognition --------------------------------------------------------

# Clustering sensitivity preset: strict, normal, loose, or custom
# OMOIDE_FACE_RECOGNITION__PRESET=loose

# Minimum detector confidence to accept a face (0.0–1.0)
# OMOIDE_FACE_RECOGNITION__FACE_RECOGNITION_MIN_CONFIDENCE=0.5

# Minimum face crop area in pixels (width × height) to keep a detection
# OMOIDE_FACE_RECOGNITION__FACE_RECOGNITION_MIN_FACE_PIXELS=1600

# Number of faces needed before a person entry is auto-created
# OMOIDE_FACE_RECOGNITION__PERSON_MIN_FACE_COUNT=2

# --- Processors --------------------------------------------------------------

# Use GPU acceleration for AI processors when available
# OMOIDE_PROCESSORS__PREFER_GPU=true

# --- Frontend (VITE_ prefix) -------------------------------------------------
# These are injected at build time or via window.runtimeConfig in production.

# Backend API base URL (leave empty when frontend is served from the same origin)
# VITE_API_BASE_URL=

# Mirror of PRESENTATION_MODE for the frontend
# VITE_API_PRESENTATION_MODE=false

# Mirror of ENABLE_PEOPLE for the frontend
# VITE_API_ENABLE_PEOPLE=true

# Mirror of MEME_MODE for the frontend
# VITE_API_MEME_MODE=false

# Maximum nodes shown in person relationship graphs
# VITE_PERSON_RELATIONSHIP_MAX_NODES=100

# Group detected faces by their source video in the faces panel
# VITE_GROUP_FACES_BY_VIDEO=true
